{% extends "layouts/main.html.twig" %}

{% block title %}Estados de Asistencia{% endblock %}
{% block page_title %}Catálogo de Estados de Asistencia{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-0 text-dark">Configuración de Estados</h5>
        <small class="text-muted">Gestiona los tipos de marcación (Presente, Tardanza, Falta, etc.) con sus colores e iconos</small>
    </div>
    <a href="{{ base_url }}/status/new" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Estado
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th style="width: 60px;">Orden</th>
                    <th>Vista Previa / Píldora</th>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Color HEX</th>
                    <th>Ícono</th>
                    <th class="text-center">¿Suma como Asistencia?</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for st in statuses %}
                <tr>
                    <td class="text-muted fw-bold">{{ st.order_num }}</td>
                    <td>
                        <span class="attendance-chip" style="background-color: {{ st.color }};">
                            <i class="{{ st.icon }}"></i> {{ st.name }}
                        </span>
                    </td>
                    <td><code class="text-dark">{{ st.code }}</code></td>
                    <td class="fw-bold">{{ st.name }}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="border rounded" style="width: 20px; height: 20px; background-color: {{ st.color }}; display: inline-block;"></span>
                            <span class="font-monospace small">{{ st.color }}</span>
                        </div>
                    </td>
                    <td><i class="{{ st.icon }} fs-5"></i> <small class="text-muted ms-1">{{ st.icon }}</small></td>
                    <td class="text-center">
                        {% if st.counts_as_present %}
                            <span class="badge bg-success-subtle text-success"><i class="bi bi-check-lg me-1"></i> Sí</span>
                        {% else %}
                            <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-lg me-1"></i> No</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <a href="{{ base_url }}/status/{{ st.id }}/edit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
