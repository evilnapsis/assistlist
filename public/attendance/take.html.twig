{% extends "layouts/main.html.twig" %}

{% block title %}Pase de Asistencia Diaria{% endblock %}
{% block page_title %}Pase de Asistencia Diaria{% endblock %}

{% block content %}
<!-- Barra de Filtros y Acciones Rápidas -->
<div class="card border-0 shadow-sm rounded-3 bg-white p-3 mb-4">
    <div class="row g-3 align-items-center">
        <!-- Selector de Fecha y Departamento -->
        <div class="col-lg-7">
            <form method="GET" action="{{ base_url }}/attendance/take" class="row g-2 align-items-center">
                <div class="col-sm-5">
                    <label class="form-label small fw-bold text-secondary text-uppercase mb-1">Fecha</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                        <input type="date" name="date" class="form-control" value="{{ date }}" onchange="this.form.submit()">
                    </div>
                </div>

                <div class="col-sm-5">
                    <label class="form-label small fw-bold text-secondary text-uppercase mb-1">Departamento</label>
                    <select name="department_id" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Todos los Departamentos --</option>
                        {% for d in departments %}
                            <option value="{{ d.id }}" {{ selected_dept == d.id ? 'selected' : '' }}>
                                [{{ d.code }}] {{ d.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-sm-2 d-flex align-items-end pt-3 pt-sm-0">
                    <button type="submit" class="btn btn-outline-secondary w-100" title="Filtrar">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Botón Masivo "Marcar Todos como Presentes" -->
        <div class="col-lg-5 text-lg-end">
            <form method="POST" action="{{ base_url }}/attendance/mark-all-present" class="d-inline-block" onsubmit="return confirm('¿Deseas marcar a todos los colaboradores mostrados como PRESENTES para el día {{ date }}?');">
                {{ csrf_field() }}
                <input type="hidden" name="date" value="{{ date }}">
                {% if selected_dept %}
                    <input type="hidden" name="department_id" value="{{ selected_dept }}">
                {% endif %}
                <button type="submit" class="btn btn-success fw-bold text-white shadow-sm">
                    <i class="bi bi-magic me-1"></i> Marcar Todos Presentes
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Resumen Rápido de la Fecha -->
<div class="d-flex align-items-center justify-content-between mb-3 px-1">
    <div class="d-flex align-items-center gap-3">
        <span class="fw-bold fs-5 text-dark">
            <i class="bi bi-calendar-check text-success me-1"></i> Lista del {{ date }}
        </span>
        <span class="badge bg-light text-dark border">
            {{ employees|length }} Empleados mostrados
        </span>
    </div>
    <div class="small">
        <span class="text-success fw-bold me-2"><i class="bi bi-check-circle-fill"></i> {{ stats.present_count }} Presentes</span>
        <span class="text-warning fw-bold me-2"><i class="bi bi-clock-history"></i> {{ stats.late_count }} Tardanzas</span>
        <span class="text-danger fw-bold"><i class="bi bi-x-circle-fill"></i> {{ stats.absent_count }} Faltas</span>
    </div>
</div>

<!-- Formulario de Marcación en Lote -->
<form method="POST" action="{{ base_url }}/attendance/save" id="attendanceForm">
    {{ csrf_field() }}
    <input type="hidden" name="date" value="{{ date }}">
    {% if selected_dept %}
        <input type="hidden" name="department_id" value="{{ selected_dept }}">
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th style="width: 280px;">Colaborador</th>
                        <th style="width: 140px;">Hora Entrada</th>
                        <th>Estado de Asistencia</th>
                        <th style="width: 250px;">Observación / Justificación</th>
                    </tr>
                </thead>
                <tbody>
                    {% if employees is empty %}
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                                No se encontraron colaboradores registrados en este departamento.
                            </td>
                        </tr>
                    {% else %}
                        {% for emp in employees %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                        {{ emp.name|slice(0, 1)|upper }}
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">{{ emp.name }} {{ emp.lastname }}</div>
                                        <small class="text-muted font-monospace">[{{ emp.code }}]</small>
                                        <small class="text-secondary">• {{ emp.department_name }}</small>
                                    </div>
                                </div>
                            </td>

                            <!-- Hora Entrada -->
                            <td>
                                <input type="time" name="attendance[{{ emp.id }}][time_in]" class="form-control form-control-sm font-monospace" value="{{ emp.today_time_in ? emp.today_time_in|slice(0, 5) : '09:00' }}">
                            </td>

                            <!-- Botones Píldora / Select de Estado -->
                            <td>
                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                    {% set isNull = (emp.today_status_id is null) %}
                                    <label class="btn btn-sm btn-outline-secondary border py-1 px-2 d-flex align-items-center gap-1 status-radio-label {{ isNull ? 'active border-secondary bg-light text-secondary fw-semibold shadow-sm' : 'text-muted' }}" style="font-size: 0.78rem;">
                                        <input type="radio" name="attendance[{{ emp.id }}][status_id]" value="" class="d-none status-radio" {{ isNull ? 'checked' : '' }} onchange="updateRadioStyle(this, '', true)">
                                        <i class="bi bi-dash-circle"></i>
                                        <span>Sin registrar</span>
                                    </label>

                                    {% for st in statuses %}
                                        {% set isSelected = (emp.today_status_id is not null and emp.today_status_id == st.id) %}
                                        <label class="btn btn-sm btn-outline-secondary border py-1 px-2 d-flex align-items-center gap-1 status-radio-label {{ isSelected ? 'active border-2 shadow-sm' : '' }}" style="font-size: 0.78rem; {{ isSelected ? 'background-color:' ~ st.color ~ '; color: #fff; border-color:' ~ st.color ~ ' !important;' : '' }}">
                                            <input type="radio" name="attendance[{{ emp.id }}][status_id]" value="{{ st.id }}" class="d-none status-radio" {{ isSelected ? 'checked' : '' }} onchange="updateRadioStyle(this, '{{ st.color }}', false)">
                                            <i class="{{ st.icon }}"></i>
                                            <span>{{ st.name }}</span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </td>

                            <!-- Observación -->
                            <td>
                                <input type="text" name="attendance[{{ emp.id }}][note]" class="form-control form-control-sm" placeholder="Ej. Retraso por metro, permiso médico..." value="{{ emp.today_note }}">
                            </td>
                        </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Botón de Guardado Fijo -->
    <div class="d-flex justify-content-end mb-5">
        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow">
            <i class="bi bi-save me-2"></i> Guardar Asistencias del Día
        </button>
    </div>
</form>
{% endblock %}

{% block javascripts %}
<script>
function updateRadioStyle(radioInput, color, isNull = false) {
    const parentRow = radioInput.closest('tr');
    const allLabels = parentRow.querySelectorAll('.status-radio-label');
    allLabels.forEach(lbl => {
        lbl.classList.remove('active', 'shadow-sm', 'bg-light', 'text-secondary', 'fw-semibold', 'border-secondary');
        lbl.style.backgroundColor = '';
        lbl.style.color = '';
        lbl.style.borderColor = '';
    });

    const activeLabel = radioInput.closest('label');
    activeLabel.classList.add('active', 'shadow-sm');
    if (isNull) {
        activeLabel.classList.add('bg-light', 'text-secondary', 'fw-semibold', 'border-secondary');
    } else {
        activeLabel.style.backgroundColor = color;
        activeLabel.style.color = '#ffffff';
        activeLabel.style.borderColor = color;
    }
}
</script>
{% endblock %}
