{% extends "layouts/main.html.twig" %}

{% block title %}Editar Colaborador{% endblock %}
{% block page_title %}Editar Colaborador{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <h5 class="fw-bold mb-3 text-dark">Modificar Datos de {{ emp.getFullname() }}</h5>

            <form method="POST" action="{{ base_url }}/employees/{{ emp.id }}/update">
                {{ csrf_field() }}

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Nombres *</label>
                        <input type="text" name="name" class="form-control" value="{{ emp.name }}" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Apellidos *</label>
                        <input type="text" name="lastname" class="form-control" value="{{ emp.lastname }}" required>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Código Empleado</label>
                        <input type="text" name="code" class="form-control" value="{{ emp.code }}" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-secondary text-uppercase">DNI / Cédula</label>
                        <input type="text" name="dni_cif" class="form-control" value="{{ emp.dni_cif }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Departamento *</label>
                        <select name="department_id" class="form-select" required>
                            <option value="">-- Seleccionar --</option>
                            {% for d in departments %}
                                <option value="{{ d.id }}" {{ emp.department_id == d.id ? 'selected' : '' }}>
                                    [{{ d.code }}] {{ d.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Cargo / Puesto *</label>
                        <input type="text" name="job_title" class="form-control" value="{{ emp.job_title }}" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Fecha de Ingreso</label>
                        <input type="date" name="hire_date" class="form-control" value="{{ emp.hire_date }}">
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Correo Electrónico</label>
                        <input type="email" name="email" class="form-control" value="{{ emp.email }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Teléfono</label>
                        <input type="text" name="phone" class="form-control" value="{{ emp.phone }}">
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Dirección Domiciliaria</label>
                        <input type="text" name="address" class="form-control" value="{{ emp.address }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Estado</label>
                        <select name="is_active" class="form-select">
                            <option value="1" {{ emp.is_active ? 'selected' : '' }}>Activo</option>
                            <option value="0" {{ not emp.is_active ? 'selected' : '' }}>Inactivo</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ base_url }}/employees" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Actualizar Datos</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
