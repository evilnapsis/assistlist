{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Departamento{% endblock %}
{% block page_title %}Registrar Departamento{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <h5 class="fw-bold mb-3 text-dark">Información del Departamento</h5>

            <form method="POST" action="{{ base_url }}/departments/create">
                {{ csrf_field() }}

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Código / Sigla</label>
                    <input type="text" name="code" class="form-control" placeholder="Ej. RRHH, IT, FIN" required>
                    <small class="text-muted">Código único para identificar el área.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Nombre del Departamento</label>
                    <input type="text" name="name" class="form-control" placeholder="Ej. Recursos Humanos" required>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Líder / Responsable</label>
                    <input type="text" name="manager_name" class="form-control" placeholder="Ej. Lic. Laura Martínez">
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Descripción</label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Funciones principales del departamento..."></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ base_url }}/departments" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Guardar Departamento</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
