{% extends "layouts/main.html.twig" %}

{% block title %}Editar Departamento{% endblock %}
{% block page_title %}Editar Departamento{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <h5 class="fw-bold mb-3 text-dark">Modificar Departamento</h5>

            <form method="POST" action="{{ base_url }}/departments/{{ dept.id }}/update">
                {{ csrf_field() }}

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Código / Sigla</label>
                    <input type="text" name="code" class="form-control" value="{{ dept.code }}" required>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Nombre del Departamento</label>
                    <input type="text" name="name" class="form-control" value="{{ dept.name }}" required>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Líder / Responsable</label>
                    <input type="text" name="manager_name" class="form-control" value="{{ dept.manager_name }}">
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Descripción</label>
                    <textarea name="description" class="form-control" rows="3">{{ dept.description }}</textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-secondary text-uppercase">Estado</label>
                    <select name="is_active" class="form-select">
                        <option value="1" {{ dept.is_active ? 'selected' : '' }}>Activo</option>
                        <option value="0" {{ not dept.is_active ? 'selected' : '' }}>Inactivo</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ base_url }}/departments" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Actualizar Departamento</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
