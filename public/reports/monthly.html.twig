{% extends "layouts/main.html.twig" %}

{% block title %}Matriz de Asistencia Mensual{% endblock %}
{% block page_title %}Matriz de Asistencia Mensual{% endblock %}

{% block content %}
<!-- Filtros del Mes, Año y Departamento -->
<div class="card border-0 shadow-sm rounded-3 bg-white p-3 mb-4">
    <form method="GET" action="{{ base_url }}/reports/monthly" class="row g-2 align-items-center">
        <div class="col-sm-3">
            <label class="form-label small fw-bold text-secondary text-uppercase mb-1">Mes</label>
            <select name="month" class="form-select" onchange="this.form.submit()">
                {% set months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'] %}
                {% for m in 1..12 %}
                    <option value="{{ m }}" {{ month == m ? 'selected' : '' }}>
                        {{ months[m - 1] }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-sm-2">
            <label class="form-label small fw-bold text-secondary text-uppercase mb-1">Año</label>
            <select name="year" class="form-select" onchange="this.form.submit()">
                {% for y in (("now"|date("Y") + 1))..(("now"|date("Y") - 3)) %}
                    <option value="{{ y }}" {{ year == y ? 'selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="col-sm-4">
            <label class="form-label small fw-bold text-secondary text-uppercase mb-1">Departamento</label>
            <select name="department_id" class="form-select" onchange="this.form.submit()">
                <option value="">-- Todos los Departamentos --</option>
                {% for d in departments %}
                    <option value="{{ d.id }}" {{ selected_dept == d.id ? 'selected' : '' }}>
                        [{{ d.code }}] {{ d.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-sm-3 d-flex align-items-end gap-2 pt-3 pt-sm-0">
            <button type="submit" class="btn btn-outline-secondary w-100">
                <i class="bi bi-funnel me-1"></i> Filtrar
            </button>
            <button type="button" class="btn btn-outline-dark" onclick="window.print()" title="Imprimir">
                <i class="bi bi-printer"></i>
            </button>
        </div>
    </form>
</div>

<!-- Leyenda de Estados -->
<div class="d-flex flex-wrap gap-2 align-items-center mb-3 p-2 bg-white rounded shadow-sm">
    <small class="text-secondary fw-bold text-uppercase me-2">Leyenda:</small>
    {% for st in statuses %}
        <span class="attendance-chip" style="background-color: {{ st.color }};">
            <i class="{{ st.icon }}"></i> {{ st.name }}
        </span>
    {% endfor %}
</div>

<!-- Matriz Cuadrícula Mensual -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size: 0.8rem;">
            <thead class="table-light">
                <tr>
                    <th class="text-start" style="min-width: 180px; position: sticky; left: 0; background: #f8fafc; z-index: 2;">
                        Colaborador
                    </th>
                    {% for d in 1..days_in_month %}
                        <th style="min-width: 32px; padding: 4px;" class="small fw-bold">{{ d }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% if employees is empty %}
                    <tr>
                        <td colspan="{{ days_in_month + 1 }}" class="py-4 text-muted">
                            No hay colaboradores para mostrar con este filtro.
                        </td>
                    </tr>
                {% else %}
                    {% for emp in employees %}
                    <tr>
                        <!-- Columna fija de nombre -->
                        <td class="text-start fw-semibold" style="position: sticky; left: 0; background: #ffffff; z-index: 1;">
                            <a href="{{ base_url }}/employees/{{ emp.id }}" class="text-dark text-decoration-none">
                                {{ emp.name }} {{ emp.lastname }}
                            </a>
                            <small class="text-muted d-block font-monospace">[{{ emp.code }}]</small>
                        </td>

                        <!-- Celdas para cada día del mes -->
                        {% for day in 1..days_in_month %}
                            {% set cell = matrix[emp.id][day]|default(null) %}
                            <td class="p-1">
                                {% if cell %}
                                    <span class="d-inline-flex align-items-center justify-content-center text-white fw-bold rounded-circle" 
                                          style="width: 24px; height: 24px; background-color: {{ cell.color }}; cursor: pointer;"
                                          title="{{ cell.status_name }}{{ cell.note ? ': ' ~ cell.note : '' }}">
                                        {{ cell.status_name|slice(0, 1)|upper }}
                                    </span>
                                {% else %}
                                    <span class="text-muted" style="opacity: 0.3;">·</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
